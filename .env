# GENERATED by scripts/skin-apply.mjs from skins/avenio/skin.json. Do not edit: edit the skin and run node scripts/skin-apply.mjs.
# These VITE_* values are public client configuration, read on the dev server only. In production Selldone
# injects the real shop, its defaults and its theme for whichever shop runs this Layout.

# fashioni (shop 15552): the shop the dev server reads (its public xapi name).
VITE_APP_SAMPLE_SHOP_NAME=fashioni

# The designed home is the shop page. Values: blog | avocado | hyper | community | shop | map | <page id>
VITE_APP_SAMPLE_SHOP_CUSTOM_HOME=shop

VITE_APP_SAMPLE_DEFAULT_CURRENCY=USD
VITE_APP_SAMPLE_DEFAULT_COUNTRY=US
VITE_APP_SAMPLE_DEFAULT_LANGUAGE=en

# The brand palette (garnet).
VITE_APP_SAMPLE_THEME_COLOR_LIGHT="#9B1B30"
VITE_APP_SAMPLE_THEME_COLOR_DARK="#800020"
VITE_APP_SAMPLE_THEME_COLOR_DEEP_DARK="#2E1819"
VITE_APP_SAMPLE_THEME_COLOR_INFO="#9B1B30"

# ▃▃▃▃▃▃▃▃▃▃▃▃ Dev Server ▃▃▃▃▃▃▃▃▃▃▃▃

VITE_APP_DEV_SERVER_HOST=localhost
VITE_APP_DEV_SERVER_PORT=9172
VITE_APP_DEV_SERVER_HTTPS=FALSE
# The account design: A, "desk" (side rail and order cards). Releases set it themselves (release.sh <version> desk).
VITE_KALIO_ACCOUNT=desk
